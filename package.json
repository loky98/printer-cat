{
  "name": "printer-cat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA para imprimir texto, imágenes y códigos en impresoras térmicas Bluetooth tipo Cat Printer",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "jsbarcode": "^3.11.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.4"
  }
}
